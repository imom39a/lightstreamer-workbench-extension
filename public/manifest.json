{
  "manifest_version": 3,
  "name": "Lightstreamer Workbench",
  "version": "2.0.4",
  "description": "Inspect Lightstreamer activity and test Item Updates or Client Messages in Chrome DevTools.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "devtools_page": "devtools.html",
  "permissions": ["storage"],
  "host_permissions": ["https://www.google-analytics.com/*"],
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["injected/lightstreamer-instrumentation.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_start"
    }
  ]
}
