# Copy to .env.local (gitignored). These are compiled into the service worker.
# Use a dedicated extension stream: a distributed Measurement Protocol key is
# extractable from the extension; it is an ingestion key, not a private credential.
VITE_LSEW_GA_MEASUREMENT_ID=G-SHFQ6R7KZK
VITE_LSEW_GA_API_SECRET=
# Use a test stream for QA. This flag makes collection visible in GA4 DebugView.
VITE_LSEW_GA_DEBUG=false
